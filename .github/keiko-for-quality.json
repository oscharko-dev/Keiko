{
  "version": 1,
  "reviewRelevant": [
    "**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
    "**/*.{c,h,m,mm,cpp,hpp,cc,cs}",
    "**/*.{sh,bash,zsh,ps1,psm1,bat,cmd}",
    "**/*.{py,rb,go,rs,java,kt,swift}",
    "**/*.{plist,entitlements,rc,csproj,props,targets}",
    "docker/**/*.{yml,yaml}",
    "docs/qa/*.json",
    "tests/**",
    "scripts/**",
    "portable-runtime-approvals.json",
    "**/*.{css,scss}",
    "release-impact.catalog.json",
    "**/*.webmanifest",
    "SECURITY.md",
    "NOTICE",
    "**/LICENSE",
    ".gitattributes",
    ".github/CODEOWNERS",
    "CODEX.md",
    "CLAUDE.md",
    "CONTRIBUTING.md",
    "AGENTS.md",
    ".github/**",
    "**/*.svg",
    "**/*.html",
    "**/*.messages.json",
    "**/*i18n*.json",
    "docs/qa/**/*.md",
    "**/Dockerfile*",
    "**/Makefile",
    "**/package.json",
    "**/package-lock.json",
    "**/tsconfig*.json",
    ".github/workflows/**/*.{yml,yaml}",
    ".github/actions/**",
    ".github/*.{json,yml,yaml}",
    ".coderabbit.yaml",
    "sonar-project.properties",
    "osv-scanner.toml",
    "socket.yml",
    "knip.json",
    "*.conf.json",
    ".dependency-cruiser.*",
    "eslint.config.*",
    ".env.example",
    "docs/adr/*.md"
  ],
  "deletionCritical": [
    ".github/keiko-for-quality.json",
    "**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
    "**/*.{c,h,m,mm,cpp,hpp,cc,cs}",
    "**/*.{sh,bash,zsh,ps1,psm1,bat,cmd}",
    "**/*.{py,rb,go,rs,java,kt,swift}",
    "**/__tests__/**",
    "tests/**",
    "scripts/**",
    "native/**",
    "docker/**",
    "sandbox/**",
    ".github/workflows/**",
    ".github/actions/**",
    "docs/adr/**",
    "docs/qa/**",
    "sonar-project.properties",
    "osv-scanner.toml",
    ".coderabbit.yaml",
    "**/*.{plist,entitlements,rc,csproj,props,targets}",
    "docs/qa/*.json",
    "portable-runtime-approvals.json",
    "release-impact.catalog.json",
    "AGENTS.md",
    "CONTRIBUTING.md",
    ".github/CODEOWNERS",
    ".gitattributes",
    "**/LICENSE",
    "SECURITY.md",
    ".github/**",
    "CLAUDE.md",
    "CODEX.md",
    "docs/qa/**/*.md"
  ],
  "generated": [
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.next/**",
    "**/*.tsbuildinfo",
    "**/__snapshots__/**",
    "**/*.min.js"
  ],
  "excluded": [
    {
      "pattern": "docs/**/evidence/**",
      "reason": "committed evidence documents are data, not code, and are validated by the deterministic gates that produced them; the harnesses that generate them are review-relevant and matched above"
    },
    {
      "pattern": "docs/**/*.{md,json}",
      "reason": "prose and acceptance data outside docs/adr; reviewed by people and by deterministic gates, not by the model"
    },
    {
      "pattern": "**/*.{png,jpg,jpeg,gif,ico,icns,webp,woff,woff2,ttf,pdf,zip,wasm}",
      "reason": "binary assets carry no reviewable source. SVG is deliberately NOT here: it is text and can carry <script>, so it is review-relevant above. Property lists likewise \u2014 a macOS entitlements plist is a privilege boundary."
    },
    {
      "pattern": "**/*.{md,mdx,txt,csv,sql,lock,snap,map,yml,yaml,json,toml,properties}",
      "reason": "remaining prose, data, and configuration not named as review-relevant above; covered by deterministic gates. HTML is deliberately NOT here: 27 design-system pages carry inline <script>, so HTML is review-relevant above."
    },
    {
      "pattern": "**/{.gitignore,.editorconfig,.prettierignore,.npmignore,.dockerignore}",
      "reason": "tooling ignore and editor files. Deliberately the LAST entry rather than a catch-all: an unmatched path must reach inventory.unclassified_path and fail the run, which a `**/*` rule made unreachable. Note .gitattributes is NOT here \u2014 it can mark sources binary and hide them from review."
    }
  ],
  "benignWarnings": []
}
