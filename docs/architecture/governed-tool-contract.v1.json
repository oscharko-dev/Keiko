{
  "schemaVersion": 1,
  "decision": "ADR-0175",
  "implementation": "architecture-only",
  "budgetDispositions": [
    "committed",
    "released",
    "not-reserved",
    "commit-uncertain",
    "release-uncertain"
  ],
  "owners": {
    "genericTypes": "keiko-contracts",
    "digestPrimitives": "keiko-security",
    "descriptorsCompiler": "keiko-tool-catalog",
    "handlers": "existing-domain-owners",
    "policy": "existing-policy-evaluators",
    "runtimeBinding": "keiko-server",
    "adapterProjections": "catalog-compiler",
    "workspaceSearch": "keiko-workspace",
    "evidence": "existing-activity-log"
  },
  "axes": {
    "toolRef": "canonicalId + contractVersion; semantic input/result/effect change requires a new version",
    "alias": "profile-local ASCII name; never identity or authority",
    "catalogRevision": "immutable digest of sorted descriptor references and profile/compatibility declarations",
    "profile": "id + version; immutable intent and native extension set",
    "adapterDialect": "id + version; exact representable schema semantics",
    "adapterRuntime": "id + pinned version; compatibility requires explicit requalification",
    "descriptorDigest": "semantic descriptor digest; changes invalidate bindings and result schema",
    "projectionDigest": "full profile/adapter semantic digest; changes invalidate offers, cursors and generated source"
  },
  "digests": {
    "descriptor": {
      "domain": "keiko.tool-descriptor.v1",
      "fields": [
        "toolRef",
        "description",
        "inputSchema",
        "resultSchema",
        "effects",
        "actionMapping",
        "policyReferences",
        "handlerRequirement",
        "bounds",
        "idempotency",
        "cancellation"
      ]
    },
    "projection": {
      "domain": "keiko.tool-projection.v1",
      "fields": [
        "catalogRevision",
        "profile",
        "adapterDialect",
        "adapterRuntime",
        "nativeExtensions",
        "tools.toolRef",
        "tools.alias",
        "tools.description",
        "tools.inputSchema",
        "tools.resultSchema",
        "tools.effects",
        "tools.actionMapping",
        "tools.policyReferences",
        "tools.handlerRequirement",
        "tools.bounds",
        "tools.descriptorDigest",
        "compatibility"
      ]
    },
    "catalog": {
      "domain": "keiko.tool-catalog.v1",
      "fields": ["sortedDescriptorDigests", "profiles", "compatibility"]
    },
    "request": {
      "domain": "keiko.tool-request.v1",
      "fields": [
        "toolRef",
        "projectionDigest",
        "workspaceIdentity",
        "workspaceRevision",
        "canonicalArguments",
        "nonce"
      ]
    },
    "cursor": {
      "domain": "keiko.tool-cursor.v1",
      "fields": [
        "toolRef",
        "requestDigest",
        "workspaceIdentity",
        "workspaceRevision",
        "profile",
        "projectionDigest",
        "expiresAt",
        "budgetReservationId",
        "nonce",
        "pageSequence"
      ]
    }
  },
  "bounds": {
    "maxArgumentBytes": 262144,
    "maxResultBytes": 262144,
    "maxSchemaDepth": 16,
    "maxObjectKeys": 128,
    "maxArrayItems": 1000,
    "maxStringBytes": 65536,
    "maxCursorBytes": 4096,
    "maxCursorLifetimeMs": 300000,
    "maxCompatibilityLifetimeMs": 604800000,
    "maxQueryCharacters": 200,
    "maxSearchHits": 50,
    "maxSearchFiles": 2000,
    "maxSearchFileBytes": 524288,
    "maxSearchDurationMs": 5000,
    "maxSnippetBytes": 512,
    "maxSearchOutputBytes": 65536,
    "maxSearchGlobsPerList": 32,
    "maxSearchGlobCharacters": 200,
    "maxSearchInventory": 50000,
    "maxSearchYieldCandidates": 32
  },
  "statuses": {
    "completed": ["none"],
    "denied": [
      "authority-invalid",
      "authority-expired",
      "authority-revoked",
      "hard-denial",
      "approval-required",
      "approval-rejected",
      "budget-exhausted",
      "workspace-denied",
      "effect-denied"
    ],
    "invalid": [
      "unknown-tool",
      "unoffered-tool",
      "ambiguous-alias",
      "invalid-arguments",
      "version-mismatch",
      "projection-mismatch",
      "unsupported-capability",
      "cursor-invalid",
      "cursor-expired",
      "cursor-replayed",
      "workspace-stale",
      "replay-conflict",
      "recovery-required"
    ],
    "busy": ["invocation-in-flight", "capacity-exhausted"],
    "cancelled": ["explicit-cancellation", "parent-cancelled"],
    "timeout": ["deadline-exceeded"],
    "failed": [
      "handler-unavailable",
      "handler-mismatch",
      "handler-failed",
      "result-contract-failed",
      "effect-outcome-unknown",
      "budget-port-failed"
    ]
  },
  "recovery": {
    "status": "invalid",
    "reason": "recovery-required",
    "condition": "A persisted binding cannot be resumed under its exact immutable identity and no live directional compatibility entry accepts it. No automatic replay or latest rebinding; human-selected restart gets a new invocation."
  },
  "readiness": ["ready", "unavailable", "dry-run", "unsupported", "mismatch"],
  "phases": {
    "projection": {
      "op": "tool-catalog.projection",
      "required": ["correlationId", "catalogRevision", "profile", "projectionDigest", "readiness"]
    },
    "bind-ready": {
      "op": "tool-catalog.bind-ready",
      "required": [
        "correlationId",
        "catalogRevision",
        "profile",
        "projectionDigest",
        "readiness",
        "handlerSetDigest"
