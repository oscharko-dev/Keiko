name = "keiko-for-quality"
main = "../../scripts/keiko-for-quality-worker.mjs"
compatibility_date = "2026-07-11"

[triggers]
crons = ["* * * * *"]

[[d1_databases]]
binding = "KEIKO_FOR_QUALITY_DB"
database_name = "keiko-for-quality"
database_id = "replace-with-production-d1-id"

[vars]
TARGET_REPOSITORY = "oscharko-dev/Keiko"
STABILITY_WINDOW_MS = "60000"
SOCKET_RISK_ALLOWLIST_JSON = '[]'
SOCKET_RISK_ACTORS_JSON = '[]'
