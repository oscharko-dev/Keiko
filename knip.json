{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": [
    "axe-core",
    "@oscharko-dev/keiko-memory-consolidation",
    "@oscharko-dev/keiko-quality-intelligence",
    "@oscharko-dev/keiko-sandbox",
    "fallow",
    "ws"
  ],
  "ignoreBinaries": ["pwsh", "mkfifo", "ldd", "sqlite3", "pgrep", "ssh-keygen"],
  "workspaces": {
    ".": {
      "playwright": false,
      "ignoreDependencies": ["java-parser"],
      "entry": [
        "src/**/*.ts!",
        "scripts/*.mjs!",
        "scripts/testing/coding-workbench-lab/*.mjs",
        "scripts/testing/chat-skills-lab/run.mjs",
        "scripts/testing/chat-skills-lab/serve.mjs",
        "scripts/testing/chat-skills-lab/verify-tests.mjs",
        "tests/e2e/**/*.spec.ts!",
        "tests/e2e/**/*.mts!",
        "tests/e2e/config/**/*.ts!",
        "tests/e2e/support/**/*.{ts,mjs}!",
        "tests/e2e/servers/**/*.mts!",
        "native/**/*.test.mjs",
        "native/**/test-*.mjs",
        "docs/design-system/evidence/1300/browser/capture.mjs",
        "scripts/testing/jira-chat-lab/browser-disconnect.mjs",
        "scripts/testing/jira-chat-lab/catalog-chat.mjs",
        "scripts/testing/jira-chat-lab/chat-faults.mjs",
        "scripts/testing/jira-chat-lab/mixed-chat.mjs",
        "scripts/testing/jira-chat-lab/preflight.mjs",
        "scripts/testing/jira-chat-lab/qualify-fields.mjs",
        "scripts/testing/jira-chat-lab/restricted-chat.mjs",
        "scripts/testing/jira-chat-lab/seed-content.mjs",
        "scripts/testing/jira-chat-lab/seed.mjs",
        "scripts/testing/jira-chat-lab/requirements/scorecard.mjs",
        "scripts/testing/jira-chat-lab/requirements/seed-projects.mjs",
        "scripts/testing/jira-chat-lab/session.mjs",
        "scripts/testing/jira-chat-lab/verify-connection.mjs",
        "scripts/testing/jira-chat-lab/tls-front.mjs"
      ],
      "project": ["src/**/*.ts", "scripts/**/*.mjs", "tests/**/*.{ts,mts,mjs}", "native/**/*.mjs"],
      "ignore": [
        "tests/architecture/fixtures/**",
        "tests/fixtures/**",
        "tests/e2e/fixtures/**",
        "packages/keiko-ui/public/**"
      ],
      "ignoreBinaries": ["openssl"]
    },
    "packages/*": {
      "entry": ["src/*.ts!", "src/**/index.ts!"]
    },
    "packages/keiko-server": {
      "entry": [
        "src/*.ts!",
        "src/*/*.ts!",
        "src/**/index.ts!",
        "src/**/testing/fake-lsp-server.mjs!"
      ],
      "ignoreBinaries": ["cc"]
    },
    "packages/keiko-contracts": {
      "entry": ["src/*.ts!", "src/*/*.ts!", "src/**/index.ts!"]
    },
    "packages/keiko-editor": {
      "entry": ["src/*.ts!", "src/*/*.ts!", "src/**/index.ts!"]
    },
    "packages/keiko-evaluations": {
      "entry": ["src/*.ts!", "src/*/*.ts!", "src/**/index.ts!"]
    },
    "packages/keiko-evidence": {
      "entry": ["src/*.ts!", "src/*/*.ts!", "src/**/index.ts!"]
    },
    "packages/keiko-harness": {
      "entry": ["src/*.ts!", "src/*/*.ts!", "src/**/index.ts!"]
    },
    "packages/keiko-local-knowledge": {
      "entry": ["src/*.ts!", "src/*/*.ts!", "src/**/index.ts!"]
    },
    "packages/keiko-model-gateway": {
      "entry": ["src/*.ts!", "src/*/*.ts!", "src/**/index.ts!"]
    },
    "packages/keiko-quality-intelligence": {
      "entry": ["src/*.ts!", "src/*/*.ts!", "src/**/index.ts!"]
    },
    "packages/keiko-security": {
      "entry": ["src/*.ts!", "src/*/*.ts!", "src/**/index.ts!"]
    },
    "packages/keiko-tools": {
      "entry": ["src/*.ts!", "src/*/*.ts!", "src/**/index.ts!"]
    },
    "packages/keiko-ui": {
      "entry": ["src/*/*.ts!", "src/**/index.ts!"]
    },
    "packages/keiko-workflows": {
      "entry": ["src/*.ts!", "src/*/*.ts!", "src/**/index.ts!"]
    }
  }
}
