{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": [
    "axe-core",
    "@oscharko-dev/keiko-git",
    "@oscharko-dev/keiko-memory-consolidation",
    "@oscharko-dev/keiko-quality-intelligence",
    "@oscharko-dev/keiko-sandbox",
    "ws"
  ],
  "ignoreBinaries": ["pwsh", "mkfifo", "ldd", "sqlite3", "pgrep"],
  "workspaces": {
    ".": {
      "playwright": false,
      "entry": [
        "src/**/*.ts!",
        "scripts/*.mjs!",
        "dist/cli/index.js!",
        "tests/e2e/**/*.spec.ts!",
        "tests/e2e/**/*.mts!",
        "tests/e2e/config/**/*.ts!",
        "tests/e2e/support/**/*.{ts,mjs}!",
        "tests/e2e/servers/**/*.mts!"
      ],
      "project": ["src/**/*.ts", "scripts/**/*.mjs", "tests/**/*.{ts,mts,mjs}", "native/**/*.mjs"],
      "ignore": [
        "tests/architecture/fixtures/**",
        "tests/fixtures/**",
        "tests/e2e/fixtures/**",
        "packages/keiko-ui/public/**",
        "native/runtime-supervisor/**"
      ]
    },
    "packages/*": {
      "entry": ["src/*.ts!", "src/**/index.ts!"]
    },
    "packages/keiko-server": {
      "entry": [
        "src/*.ts!",
        "src/*/*.ts!",
        "src/**/index.ts!",
        "src/**/testing/fake-lsp-server.mjs!"
      ]
    },
    "packages/keiko-contracts": {
      "entry": ["src/*.ts!", "src/*/*.ts!", "src/**/index.ts!"]
    },
    "packages/keiko-editor": {
      "entry": ["src/*.ts!", "src/*/*.ts!", "src/**/index.ts!"]
    },
    "packages/keiko-evaluations": {
      "entry": ["src/*.ts!", "src/*/*.ts!", "src/**/index.ts!"]
    },
    "packages/keiko-evidence": {
      "entry": ["src/*.ts!", "src/*/*.ts!", "src/**/index.ts!"]
    },
    "packages/keiko-harness": {
      "entry": ["src/*.ts!", "src/*/*.ts!", "src/**/index.ts!"]
    },
    "packages/keiko-local-knowledge": {
      "entry": ["src/*.ts!", "src/*/*.ts!", "src/**/index.ts!"]
    },
    "packages/keiko-model-gateway": {
      "entry": ["src/*.ts!", "src/*/*.ts!", "src/**/index.ts!"]
    },
    "packages/keiko-quality-intelligence": {
      "entry": ["src/*.ts!", "src/*/*.ts!", "src/**/index.ts!"]
    },
    "packages/keiko-security": {
      "entry": ["src/*.ts!", "src/*/*.ts!", "src/**/index.ts!"]
    },
    "packages/keiko-tools": {
      "entry": ["src/*.ts!", "src/*/*.ts!", "src/**/index.ts!"]
    },
    "packages/keiko-ui": {
      "entry": ["src/*/*.ts!", "src/**/index.ts!"]
    },
    "packages/keiko-workflows": {
      "entry": ["src/*.ts!", "src/*/*.ts!", "src/**/index.ts!"]
    }
  }
}
