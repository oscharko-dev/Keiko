{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": [
    "axe-core",
    "@oscharko-dev/keiko-memory-consolidation",
    "@oscharko-dev/keiko-quality-intelligence",
    "@oscharko-dev/keiko-sandbox",
    "@oscharko-dev/keiko-tool-catalog",
    "ws",
    "@oscharko-dev/keiko-coding-runtime-darwin-arm64",
    "@oscharko-dev/keiko-coding-runtime-darwin-x64"
  ],
  "ignoreBinaries": ["pwsh", "mkfifo", "ldd", "sqlite3", "pgrep", "ssh-keygen"],
  "workspaces": {
    ".": {
      "playwright": false,
      "entry": [
        "src/**/*.ts!",
        "scripts/*.mjs!",
        "scripts/testing/coding-workbench-lab/*.mjs",
        "tests/e2e/**/*.spec.ts!",
        "tests/e2e/**/*.mts!",
        "tests/e2e/config/**/*.ts!",
        "tests/e2e/support/**/*.{ts,mjs}!",
        "tests/e2e/servers/**/*.mts!"
      ],
      "project": ["src/**/*.ts", "scripts/**/*.mjs", "tests/**/*.{ts,mts,mjs}", "native/**/*.mjs"],
      "ignore": [
        "tests/architecture/fixtures/**",
        "tests/fixtures/**",
        "tests/e2e/fixtures/**",
        "packages/keiko-ui/public/**"
      ]
    },
    "packages/*": {
      "entry": ["src/*.ts!", "src/**/index.ts!"]
    },
    "packages/keiko-server": {
      "entry": [
        "src/*.ts!",
        "src/*/*.ts!",
        "src/**/index.ts!",
        "src/**/testing/fake-lsp-server.mjs!"
      ],
      "ignoreBinaries": ["cc"]
    },
    "packages/keiko-contracts": {
      "entry": ["src/*.ts!", "src/*/*.ts!", "src/**/index.ts!"]
    },
    "packages/keiko-editor": {
      "entry": ["src/*.ts!", "src/*/*.ts!", "src/**/index.ts!"]
    },
    "packages/keiko-evaluations": {
      "entry": ["src/*.ts!", "src/*/*.ts!", "src/**/index.ts!"]
    },
    "packages/keiko-evidence": {
      "entry": ["src/*.ts!", "src/*/*.ts!", "src/**/index.ts!"]
    },
    "packages/keiko-harness": {
      "entry": ["src/*.ts!", "src/*/*.ts!", "src/**/index.ts!"]
    },
    "packages/keiko-local-knowledge": {
      "entry": ["src/*.ts!", "src/*/*.ts!", "src/**/index.ts!"]
    },
    "packages/keiko-model-gateway": {
      "entry": ["src/*.ts!", "src/*/*.ts!", "src/**/index.ts!"]
    },
    "packages/keiko-quality-intelligence": {
      "entry": ["src/*.ts!", "src/*/*.ts!", "src/**/index.ts!"]
    },
    "packages/keiko-security": {
      "entry": ["src/*.ts!", "src/*/*.ts!", "src/**/index.ts!"]
    },
    "packages/keiko-tools": {
      "entry": ["src/*.ts!", "src/*/*.ts!", "src/**/index.ts!"]
    },
    "packages/keiko-ui": {
      "entry": ["src/*/*.ts!", "src/**/index.ts!"]
    },
    "packages/keiko-workflows": {
      "entry": ["src/*.ts!", "src/*/*.ts!", "src/**/index.ts!"]
    },
    "native/opencode-service-host": {
      "entry": ["host.mjs", "entry.mjs", "entry.test.mjs", "guard-seams.test.mjs", "host.test.mjs"],
      "project": ["*.mjs"],
      "vitest": false,
      "ignoreDependencies": ["@effect/platform-node-shared"],
      "ignoreUnresolved": [
        "^\\./keiko-native-file-io-codec\\.mjs$",
        "^\\./keiko-workspace-path-policy/ignore\\.js$",
        "^\\./keiko-governed-tools\\.mjs$",
        "^\\./keiko-governed-tools-code-mode\\.mjs$",
        "^\\./keiko-host-packet-data\\.mjs$",
        "^\\./keiko-native-context\\.mjs$"
      ]
    }
  }
}
