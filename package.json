    "portable:approve-runtimes": "node scripts/update-portable-runtime-approvals.mjs",
    "portable:verify-signing": "node scripts/verify-portable-runtime-signing.mjs",
    "portable:manual-review": "npm run build:packages && npm run build:ui && node --disable-warning=ExperimentalWarning scripts/portable-manual-review.mjs",
    "smoke:portable-launch-setup": "npm run build:packages && node --disable-warning=ExperimentalWarning scripts/portable-launch-setup-smoke.mjs",
    "smoke:install": "node scripts/installable-package-smoke.mjs",
    "smoke:install:optional": "node scripts/installable-package-smoke.mjs --include-optional",
    "smoke:install:memory": "node scripts/installable-memory-smoke.mjs",
    "check:workspace-supply-chain": "node scripts/check-workspace-supply-chain.mjs",
    "check:qi-supply-chain": "node scripts/check-quality-intelligence-supply-chain.mjs",
    "check:local-state": "node --experimental-sqlite --disable-warning=ExperimentalWarning scripts/check-local-state.mjs --self-test",
    "check:shell-spawn-guardrails": "node scripts/check-shell-spawn-guardrails.mjs",
    "check:security-regression-matrix": "node scripts/check-security-regression-matrix.mjs",
    "audit:local-state": "node --experimental-sqlite --disable-warning=ExperimentalWarning scripts/check-local-state.mjs",
    "check:coverage": "node scripts/check-package-coverage.mjs --baseline docs/qa/package-coverage-baseline.json --enforce-file-floors",
    "check:coverage:write-baseline": "node scripts/check-package-coverage.mjs --baseline docs/qa/package-coverage-baseline.json --write-baseline docs/qa/package-coverage-baseline.json --file-floor-threshold 50",
    "check:coverage:packages": "node scripts/check-package-coverage.mjs --baseline docs/qa/package-coverage-baseline.json --coverage coverage/packages/coverage-summary.json --exclude-package keiko-ui",
    "check:coverage:ui": "node scripts/check-package-coverage.mjs --baseline docs/qa/package-coverage-baseline.json --coverage packages/keiko-ui/coverage/coverage-summary.json --package keiko-ui",
    "check:coverage:strict": "node scripts/check-package-coverage.mjs --baseline docs/qa/package-coverage-baseline.json --strict",
    "check:coverage:release-targets": "node scripts/check-package-coverage.mjs --baseline docs/qa/package-coverage-baseline.json --coverage packages/keiko-ui/coverage/coverage-summary.json --package keiko-ui --target 88 --strict && node scripts/check-package-coverage.mjs --baseline docs/qa/package-coverage-baseline.json --coverage coverage/packages/coverage-summary.json --package keiko-cli --target 87 --strict",
    "check:coverage:branches": "node scripts/check-package-coverage.mjs --baseline docs/qa/package-coverage-baseline.json --metric branches",
    "check:coverage:statements": "node scripts/check-package-coverage.mjs --baseline docs/qa/package-coverage-baseline.json --metric statements",
    "check:coverage:functions": "node scripts/check-package-coverage.mjs --baseline docs/qa/package-coverage-baseline.json --metric functions",
    "check:lcov-source-mapping": "node scripts/check-lcov-source-mapping.mjs --base origin/dev --head HEAD",
    "check:coverage:branches:strict": "node scripts/check-package-coverage.mjs --baseline docs/qa/package-coverage-baseline.json --metric branches --strict",
    "arch:check": "depcruise --validate .dependency-cruiser.cjs src packages && node scripts/check-import-policy.mjs && node scripts/check-contract-boundaries.mjs",
    "arch:check:negative": "node scripts/arch-check-negative.mjs",
    "codex:pre-pr": "node scripts/codex-pre-pr.mjs",
    "conversation:release-check": "npm run typecheck && npm run lint && npm run arch:check && npm run arch:check:negative && npm test && tsc -p tsconfig.build.json && node dist/cli/index.js --version",
    "prepack": "npm run clean && npm run build && npm run prepare:bin && npm run build:ui && npm run check:editor-release-evidence && npm run prune:package-build-artifacts && npm run prune:package-native-optionals && npm run check:shell-spawn-guardrails && npm run check:security-regression-matrix && npm run arch:check && npm run arch:check:negative && npm run check:workspace-supply-chain && npm run check:package-surface && npm run check:version-consistency && npm run check:publish-manifests && npm run check:portable-manifest && npm run check:release-impact && npm run check:qi-supply-chain",
    "prepublishOnly": "npm run clean && npm run build && npm run prepare:bin && npm run build:ui && npm run check:editor-release-evidence && npm run prune:package-build-artifacts && npm run prune:package-native-optionals && npm run check:shell-spawn-guardrails && npm run check:security-regression-matrix && npm run arch:check && npm run arch:check:negative && npm run check:workspace-supply-chain && npm run check:package-surface && npm run check:version-consistency && npm run check:publish-manifests && npm run check:portable-manifest && npm run check:release-impact:publish && npm run check:qi-supply-chain",
    "clean": "node scripts/clean.mjs",
    "test:mutation:security:run": "stryker run stryker.security.conf.json",
    "check:mutation:baseline": "node scripts/check-mutation-quality.mjs",
    "check:mutation:scoped": "node scripts/check-mutation-quality.mjs --scoped",
    "test:mutation:security": "npm run test:mutation:security:run && npm run check:mutation:baseline",
    "check:publish-manifests": "node scripts/check-publish-manifests.mjs",
    "smoke:registry-install": "node scripts/registry-install-smoke.mjs"
  },
