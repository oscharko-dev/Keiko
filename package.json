{
  "name": "@oscharko-dev/keiko",
  "version": "0.2.15",
  "description": "Enterprise model-agnostic developer-assist coding agent for regulated engineering workflows.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/oscharko-dev/Keiko"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10.9.0"
  },
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "keiko": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "TRADEMARKS.md",
    "release-impact.catalog.json"
  ],
  "sideEffects": false,
  "scripts": {
    "build:packages": "tsc -b tsconfig.packages.json",
    "build": "npm run build:packages && tsc -p tsconfig.build.json",
    "keiko:start": "node dist/cli/index.js start",
    "keiko:stop": "node dist/cli/index.js stop",
    "keiko:status": "node dist/cli/index.js status",
    "typecheck": "npm run build:packages && npm run check:package-graph && tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0 && npm --workspace @oscharko-dev/keiko-ui run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build:packages && vitest run",
    "test:coverage": "npm run test:coverage:quality",
    "test:coverage:packages": "npm run build:packages && vitest run --config vitest.coverage.packages.config.ts --coverage",
    "test:coverage:ui": "vitest run --config packages/keiko-ui/vitest.coverage.config.ts --coverage",
    "test:coverage:scripts": "vitest run scripts/__tests__ --coverage --coverage.reportsDirectory=coverage/scripts",
    "test:coverage:quality": "npm run test:coverage:packages && npm run test:coverage:ui && npm run test:coverage:scripts && npm run check:coverage && npm run check:coverage:release-targets && npm run check:coverage:statements && npm run check:coverage:branches && npm run check:coverage:functions",
    "test:managed-lsp-closeout": "npm run build:packages && vitest run packages/keiko-contracts/src/managed-lsp-activation.test.ts packages/keiko-contracts/src/managed-lsp-capabilities.test.ts packages/keiko-contracts/src/managed-lsp-evidence.test.ts packages/keiko-contracts/src/managed-lsp-runtime.test.ts packages/keiko-server/src/editor/lsp/managedLspControl.test.ts packages/keiko-server/src/editor/lsp/managedLspPolicy.test.ts packages/keiko-server/src/editor/lsp/managedLspRoutes.test.ts packages/keiko-server/src/editor/lsp/providerOperationMatrix.test.ts packages/keiko-server/src/editor/lsp/lspSecurity.test.ts packages/keiko-server/src/editor/lsp/lspProcessManager.test.ts packages/keiko-server/src/editor/lsp/lspSemanticTokens.test.ts packages/keiko-server/src/editor/lsp/providers packages/keiko-tools/src/editor-agent-tool-host.test.ts packages/keiko-ui/src/app/components/desktop/widgets/panels/ManagedLanguageSettings.test.tsx tests/editor-agent-managed-lsp.integration.test.ts",
    "check:managed-lsp-performance": "npm run build:packages && node scripts/measure-managed-lsp-closeout.mjs",
    "test:e2e:smoke": "playwright test --config tests/e2e/config/playwright.config.ts --project=chromium --grep @smoke",
    "test:e2e:local-knowledge": "playwright test --config tests/e2e/config/playwright.local-knowledge-regression.config.ts",
    "test:e2e:editor-perf": "playwright test --config tests/e2e/config/playwright.editor-performance.config.ts --project=chromium --grep @release-evidence",
    "test:e2e:workspace-perf": "playwright test --config tests/e2e/config/playwright.workspace-performance.config.ts --project=chromium --grep @release-evidence",
    "test:e2e:workspace-search-2090": "playwright test --config tests/e2e/config/playwright.issue-2090-workspace-search.config.ts --project=chromium",
    "test:e2e:editor-fidelity-1295": "playwright test --config tests/e2e/config/playwright.issue-1295-editor-fidelity.config.ts --project=chromium",
    "test:e2e:editor-fidelity-1296": "playwright test --config tests/e2e/config/playwright.issue-1296-editor-agent.config.ts --project=chromium",
    "test:e2e:editor-agent-1394": "playwright test --config tests/e2e/config/playwright.issue-1394-editor-agent.config.ts --project=chromium",
    "test:e2e:editor-chat-2119": "playwright test tests/e2e/editor-chat-roundtrip-2119.spec.ts --config tests/e2e/config/playwright.config.ts --project=chromium",
    "test:e2e:editor-agent-docking-2122": "playwright test --config tests/e2e/config/playwright.issue-2122-editor-agent-docking.config.ts --project=chromium",
    "test:e2e:editor-run-verification-2215": "playwright test --config tests/e2e/config/playwright.issue-2215-editor-run-verification.config.ts --project=chromium",
    "test:e2e:editor-source-control-2235": "playwright test --config tests/e2e/config/playwright.issue-2235-editor-source-control.config.ts --project=chromium",
    "test:e2e:editor-governance-1395": "playwright test --config tests/e2e/config/playwright.issue-1395-editor-agent.config.ts --project=chromium",
    "test:e2e:editor-layout-1375": "playwright test --config tests/e2e/config/playwright.issue-1375-editor-layout.config.ts --project=chromium",
    "test:e2e:editor-baseline-1377": "playwright test --config tests/e2e/config/playwright.issue-1377-editor-baseline.config.ts --project=chromium",
    "test:e2e:formatting-1380": "playwright test --config tests/e2e/config/playwright.issue-1380-formatting.config.ts",
    "test:e2e:language-intelligence-1383": "playwright test --config tests/e2e/config/playwright.issue-1383-language-intelligence.config.ts --project=chromium",
    "test:e2e:task-binding-446": "playwright test --config tests/e2e/config/playwright.issue-446-task-workspace-binding.config.ts --project=chromium",
    "test:e2e:git-delivery-475": "playwright test --config tests/e2e/config/playwright.issue-475-git-delivery.config.ts --project=chromium",
    "test:e2e:git-changes-1575": "playwright test --config tests/e2e/config/playwright.issue-1575-git-changes.config.ts --project=chromium",
    "test:e2e:git-branch-sync-1576": "playwright test --config tests/e2e/config/playwright.issue-1576-git-branch-sync.config.ts --project=chromium",
    "test:e2e:git-pr-merge-1577": "playwright test --config tests/e2e/config/playwright.issue-1577-git-pr-merge.config.ts --project=chromium",
    "test:e2e:git-client-closeout-1578": "playwright test --config tests/e2e/config/playwright.issue-1578-git-client-closeout.config.ts --project=chromium",
    "test:e2e:git-publish-476": "playwright test --config tests/e2e/config/playwright.issue-476-git-publish.config.ts --project=chromium",
    "test:e2e:pr-command-center-477": "playwright test --config tests/e2e/config/playwright.issue-477-pr-command-center.config.ts --project=chromium",
    "test:e2e:merge-governance-478": "playwright test --config tests/e2e/config/playwright.issue-478-merge-governance.config.ts --project=chromium",
    "test:e2e:update-ui-1696": "playwright test --config tests/e2e/config/playwright.issue-1696-update-ui.config.ts --project=chromium",
    "test:e2e:workspace-selection-2060": "playwright test --config tests/e2e/config/playwright.issue-2060-workspace-selection.config.ts --project=chromium",
    "test:e2e:update-pr-1907": "playwright test --config tests/e2e/config/playwright.issue-1907-update-pr.config.ts --project=chromium",
    "test:e2e:coding-workbench-1990": "playwright test --config tests/e2e/config/playwright.issue-1990-coding-workbench.config.ts --project=chromium",
    "test:e2e:coding-workbench-1991": "playwright test --config tests/e2e/config/playwright.issue-1991-governed-assist.config.ts --project=chromium",
    "test:e2e:coding-workbench-1992": "playwright test --config tests/e2e/config/playwright.issue-1992-supervised-coding.config.ts --project=chromium",
    "test:e2e:coding-workbench-1994": "playwright test --config tests/e2e/config/playwright.issue-1994-coding-workbench-closeout.config.ts --project=chromium",
    "test:release:smoke": "npm run test:e2e:smoke",
    "release:plan": "node scripts/release-publish.mjs --plan-only",
    "release:publish": "node scripts/release-publish.mjs",
    "eval:prompt-enhancer": "npm run build:packages && vitest run packages/keiko-evaluations/src/promptEnhancer",
    "eval:voice-acoustic": "npm run build:packages && node -e \"import('./packages/keiko-evaluations/dist/index.js').then(({ VoiceAcousticEval }) => { const scorecard = VoiceAcousticEval.runVoiceAcousticEvaluation(); console.log(VoiceAcousticEval.renderVoiceAcousticSummary(scorecard)); process.exitCode = scorecard.summary.goNoGo === 'GO' ? 0 : 1; })\"",
    "dev:start": "node scripts/dev-start.mjs",
    "dev:stop": "node scripts/dev-stop.mjs",
    "prepare:bin": "node scripts/ensure-bin-mode.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "prune:package-build-artifacts": "node scripts/prune-package-build-artifacts.mjs",
    "prune:package-native-optionals": "node scripts/prune-package-native-optionals.mjs",
    "check:package-surface": "node scripts/check-package-surface.mjs",
    "check:editor-bundle-size": "node scripts/editor-bundle-size.mjs",
    "check:editor-release-evidence": "node scripts/editor-release-evidence.mjs",
    "check:perf-evidence": "node scripts/check-perf-evidence.mjs",
    "check:retrieval-latency": "node scripts/check-retrieval-latency.mjs",
    "check:retrieval-quality": "node --disable-warning=ExperimentalWarning scripts/check-retrieval-quality.mjs",
    "check:grounded-retrieval-quality": "node scripts/check-grounded-retrieval-quality.mjs",
    "check:grounded-faithfulness": "node scripts/check-grounded-faithfulness.mjs",
    "check:context-quality": "node scripts/check-context-quality.mjs",
    "check:error-observability": "node scripts/check-error-observability.mjs",
    "check:dependency-hygiene": "node scripts/check-dependency-hygiene.mjs",
    "check:git-delivery-evidence": "node scripts/check-git-delivery-evidence.mjs",
    "check:git-client-evidence": "node scripts/check-git-client-evidence.mjs",
    "check:ui-i18n": "node scripts/check-ui-i18n-guard.mjs",
    "check:editor-doc-links": "node scripts/check-editor-doc-links.mjs",
    "check:adr-index": "node scripts/check-adr-index.mjs",
    "check:package-graph": "node scripts/check-package-graph.mjs",
    "check:version-consistency": "node scripts/check-version-consistency.mjs",
    "check:release-required-workflows": "node scripts/check-release-required-workflow-names.mjs",
    "check:release-impact": "node scripts/check-release-impact.mjs",
    "check:release-impact:publish": "node scripts/check-release-impact.mjs --publish",
