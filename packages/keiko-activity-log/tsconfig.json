{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "resolveJsonModule": true
  },
  "include": ["src", "src/**/*.json"],
  "exclude": ["dist", "node_modules", "**/*.test.ts", "**/_support.ts", "src/**/test-support/**"],
  "references": [
    {
      "path": "../keiko-contracts/tsconfig.json"
    },
    {
      "path": "../keiko-security/tsconfig.json"
    }
  ]
}
