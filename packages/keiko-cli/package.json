{
  "name": "@oscharko-dev/keiko-cli",
  "version": "0.2.10",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Internal CLI package: command modules for the `keiko` binary shipped via the root product package (ADR-0019). Not published independently.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@oscharko-dev/keiko-contracts": "0.2.10",
    "@oscharko-dev/keiko-security": "0.2.10",
    "@oscharko-dev/keiko-model-gateway": "0.2.10",
    "@oscharko-dev/keiko-workspace": "0.2.10",
    "@oscharko-dev/keiko-tools": "0.2.10",
    "@oscharko-dev/keiko-evaluations": "0.2.10",
    "@oscharko-dev/keiko-evidence": "0.2.10",
    "@oscharko-dev/keiko-verification": "0.2.10",
    "@oscharko-dev/keiko-harness": "0.2.10",
    "@oscharko-dev/keiko-sdk": "0.2.10",
    "@oscharko-dev/keiko-workflows": "0.2.10",
    "@oscharko-dev/keiko-server": "0.2.10",
    "@oscharko-dev/keiko-memory-vault": "0.2.10"
  }
}
