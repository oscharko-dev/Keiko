{
  "name": "@oscharko-dev/keiko-cli",
  "version": "1.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Internal CLI package: command modules for the `keiko` binary shipped via the root product package (ADR-0019). Not published independently.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24.18.0 <25 || >=26.3.0 <27"
  },
  "dependencies": {
    "@oscharko-dev/keiko-contracts": "1.0.0",
    "@oscharko-dev/keiko-security": "1.0.0",
    "@oscharko-dev/keiko-model-gateway": "1.0.0",
    "@oscharko-dev/keiko-workspace": "1.0.0",
    "@oscharko-dev/keiko-tools": "1.0.0",
    "@oscharko-dev/keiko-evaluations": "1.0.0",
    "@oscharko-dev/keiko-evidence": "1.0.0",
    "@oscharko-dev/keiko-verification": "1.0.0",
    "@oscharko-dev/keiko-harness": "1.0.0",
    "@oscharko-dev/keiko-sdk": "1.0.0",
    "@oscharko-dev/keiko-workflows": "1.0.0",
    "@oscharko-dev/keiko-server": "1.0.0",
    "@oscharko-dev/keiko-memory-vault": "1.0.0"
  },
  "private": true
}
