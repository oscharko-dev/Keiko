    { "path": "../keiko-security/tsconfig.json" },
    { "path": "../keiko-model-gateway/tsconfig.json" },
    { "path": "../keiko-workspace/tsconfig.json" },
    { "path": "../keiko-tools/tsconfig.json" },
    { "path": "../keiko-evaluations/tsconfig.json" },
    { "path": "../keiko-evidence/tsconfig.json" },
    { "path": "../keiko-verification/tsconfig.json" },
    { "path": "../keiko-harness/tsconfig.json" },
    { "path": "../keiko-sdk/tsconfig.json" },
    { "path": "../keiko-workflows/tsconfig.json" },
    { "path": "../keiko-server/tsconfig.json" },
    { "path": "../keiko-memory-vault/tsconfig.json" }
  ]
}
