{
  "name": "@oscharko-dev/keiko-model-gateway",
  "version": "1.5.10",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Internal workspace package: Keiko model gateway — provider abstraction, OpenAI-compatible adapter, capability registry, routing, resilience, TLS handling. Not published independently.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internal/http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./internal/resilience": {
      "types": "./dist/resilience.d.ts",
      "import": "./dist/resilience.js"
    },
    "./internal/prompt-calibration": {
      "types": "./dist/prompt-calibration.d.ts",
      "import": "./dist/prompt-calibration.js"
    },
    "./internal/prompt-token-accounting": {
      "types": "./dist/prompt-token-accounting.d.ts",
      "import": "./dist/prompt-token-accounting.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "dependencies": {
    "@oscharko-dev/keiko-contracts": "1.5.10",
    "@oscharko-dev/keiko-security": "1.5.10",
    "@oscharko-dev/keiko-tool-catalog": "1.5.10"
  },
  "private": true
}
