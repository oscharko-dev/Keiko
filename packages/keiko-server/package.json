{
  "name": "@oscharko-dev/keiko-server",
  "version": "1.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Internal server package: local loopback BFF runtime (HTTP/SSE/WebSocket router, CSP, host check, CSRF gate, terminal, browser, files, run engine, SQLite-backed UI store) that mediates the browser presentation tier and the Node-side domain packages (ADR-0019). Not published independently.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./credential-vault": {
      "types": "./dist/credentialVault.d.ts",
      "import": "./dist/credentialVault.js"
    },
    "./runtime/tool-catalog-lifecycle": {
      "types": "./dist/tool-catalog/catalogToolLifecycle.d.ts",
      "import": "./dist/tool-catalog/catalogToolLifecycle.js"
    },
    "./diagnostics-log": {
      "types": "./dist/diagnostics-log.d.ts",
      "import": "./dist/diagnostics-log.js"
    },
    "./observability/server-log": {
      "types": "./dist/observability/server-log.d.ts",
      "import": "./dist/observability/server-log.js"
    },
    "./tool-catalog/catalogToolDispatch": {
      "types": "./dist/tool-catalog/catalogToolDispatch.d.ts",
      "import": "./dist/tool-catalog/catalogToolDispatch.js"
    },
    "./tool-catalog/catalogToolPorts": {
      "types": "./dist/tool-catalog/catalogToolPorts.d.ts",
      "import": "./dist/tool-catalog/catalogToolPorts.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "bench:reconciliation-gitdir-pointer": "vitest bench src/task-workspace/reconciliation-gitdir-pointer-parse.bench.ts"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24.18.0 <25 || >=26.3.0 <27"
  },
  "dependencies": {
    "@oscharko-dev/keiko-connectors": "1.0.0",
    "@oscharko-dev/keiko-contracts": "1.0.0",
    "@oscharko-dev/keiko-evidence": "1.0.0",
    "@oscharko-dev/keiko-git": "1.0.0",
    "@oscharko-dev/keiko-harness": "1.0.0",
    "@oscharko-dev/keiko-local-knowledge": "1.0.0",
    "@oscharko-dev/keiko-memory-capture": "1.0.0",
    "@oscharko-dev/keiko-memory-consolidation": "1.0.0",
    "@oscharko-dev/keiko-memory-governance": "1.0.0",
    "@oscharko-dev/keiko-memory-retrieval": "1.0.0",
    "@oscharko-dev/keiko-memory-vault": "1.0.0",
    "@oscharko-dev/keiko-model-gateway": "1.0.0",
    "@oscharko-dev/keiko-quality-intelligence": "1.0.0",
    "@oscharko-dev/keiko-sandbox": "1.0.0",
    "@oscharko-dev/keiko-sdk": "1.0.0",
    "@oscharko-dev/keiko-security": "1.0.0",
    "@oscharko-dev/keiko-tool-catalog": "1.0.0",
    "@oscharko-dev/keiko-tools": "1.0.0",
    "@oscharko-dev/keiko-verification": "1.0.0",
    "@oscharko-dev/keiko-workflows": "1.0.0",
    "@oscharko-dev/keiko-workspace": "1.0.0",
    "@sigstore/bundle": "^5.0.0",
    "@sigstore/protobuf-specs": "^0.5.2",
    "@sigstore/tuf": "^5.0.0",
    "@sigstore/verify": "^4.1.2",
    "smol-toml": "^1.7.1",
    "typescript": "~6.0.3",
    "ws": "^8.21.0",
    "yauzl": "^3.4.0"
  },
  "private": true
}
