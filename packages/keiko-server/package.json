{
  "name": "@oscharko-dev/keiko-server",
  "version": "0.2.15",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Internal server package: local loopback BFF runtime (HTTP/SSE/WebSocket router, CSP, host check, CSRF gate, terminal, browser, files, run engine, SQLite-backed UI store) that mediates the browser presentation tier and the Node-side domain packages (ADR-0019). Not published independently.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./credential-vault": {
      "types": "./dist/credentialVault.d.ts",
      "import": "./dist/credentialVault.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@oscharko-dev/keiko-contracts": "0.2.15",
    "@oscharko-dev/keiko-git": "0.2.15",
    "@oscharko-dev/keiko-security": "0.2.15",
    "@oscharko-dev/keiko-model-gateway": "0.2.15",
    "@oscharko-dev/keiko-quality-intelligence": "0.2.15",
    "@oscharko-dev/keiko-local-knowledge": "0.2.15",
    "@oscharko-dev/keiko-workspace": "0.2.15",
    "@oscharko-dev/keiko-sandbox": "0.2.15",
    "@oscharko-dev/keiko-tools": "0.2.15",
    "@oscharko-dev/keiko-evidence": "0.2.15",
    "@oscharko-dev/keiko-verification": "0.2.15",
    "@oscharko-dev/keiko-harness": "0.2.15",
    "@oscharko-dev/keiko-sdk": "0.2.15",
    "@oscharko-dev/keiko-workflows": "0.2.15",
    "@oscharko-dev/keiko-memory-vault": "0.2.15",
    "@oscharko-dev/keiko-memory-governance": "0.2.15",
    "@oscharko-dev/keiko-memory-retrieval": "0.2.15",
    "@oscharko-dev/keiko-memory-capture": "0.2.15",
    "@oscharko-dev/keiko-memory-consolidation": "0.2.15",
    "ws": "^8.21.0",
    "typescript": "^6.0.3",
    "yauzl": "^3.4.0"
  },
  "private": true
}
