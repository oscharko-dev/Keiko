{
  "name": "@oscharko-dev/keiko-ui",
  "version": "0.2.15",
  "description": "Keiko Wave 1 local UI (static export). Build-time-only; served by the Node BFF in keiko-server.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "node --max-old-space-size=8192 ../../node_modules/eslint/bin/eslint.js . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "typecheck:native": "npm --prefix ../.. run check:typescript-toolchain && node ../../node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit --incremental false",
    "test": "vitest run"
  },
  "browserslist": [
    "chrome >= 79",
    "edge >= 79",
    "firefox >= 72",
    "safari >= 13.1"
  ],
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@oscharko-dev/keiko-contracts": "0.2.15",
    "@oscharko-dev/keiko-editor": "0.2.15",
    "diff": "9.0.0",
    "monaco-editor": "0.55.1",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/jest-axe": "3.5.9",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "autoprefixer": "10.5.2",
    "axe-core": "4.12.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "jest-axe": "10.0.0",
    "jsdom": "29.1.1",
    "postcss": "8.5.16",
    "typescript": "5.7.3",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": "11.16.0"
  },
  "private": true
}
