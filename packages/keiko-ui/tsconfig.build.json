{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "types": ["node"]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "out",
    ".next",
    "__tests__",
    "src/test-utils",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test-fixture.ts",
    "**/*.test-fixtures.ts",
    "vitest.config.ts",
    "vitest.coverage.config.ts",
    "vitest.setup.ts",
    "vitest-axe.d.ts"
  ]
}
