{
  "name": "@oscharko-dev/keiko-workflows",
  "version": "0.2.15",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Internal workflows package: reviewable developer-assist workflows (unit-test generation, bug investigation), prompts/parsers/guards/report rendering, apply-mode verification gating, and UI descriptors (ADR-0008 + ADR-0009 + ADR-0019). Not published independently.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./context-budget": {
      "types": "./dist/context-budget/index.d.ts",
      "import": "./dist/context-budget/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "dependencies": {
    "@oscharko-dev/keiko-contracts": "0.2.15",
    "@oscharko-dev/keiko-security": "0.2.15",
    "@oscharko-dev/keiko-model-gateway": "0.2.15",
    "@oscharko-dev/keiko-workspace": "0.2.15",
    "@oscharko-dev/keiko-tools": "0.2.15",
    "@oscharko-dev/keiko-evidence": "0.2.15",
    "@oscharko-dev/keiko-verification": "0.2.15",
    "@oscharko-dev/keiko-harness": "0.2.15",
    "@oscharko-dev/keiko-quality-intelligence": "0.2.15"
  },
  "private": true
}
