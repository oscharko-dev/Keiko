{
  "name": "@oscharko-dev/keiko-workspace",
  "version": "0.3.17",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Internal workspace package: Keiko repository context and workspace access \u2014 detection, safe reads, path containment, deny/ignore rules, context packs, retrieval, and summaries. Not published independently.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internal/fs": {
      "types": "./dist/fs.d.ts",
      "import": "./dist/fs.js"
    },
    "./internal/owned-root": {
      "types": "./dist/ownedRoot.d.ts",
      "import": "./dist/ownedRoot.js"
    },
    "./internal/owned-root-mint": {
      "types": "./dist/ownedRootMint.d.ts",
      "import": "./dist/ownedRootMint.js"
    },
    "./internal/owned-root-preserve": {
      "types": "./dist/ownedRootPreserve.d.ts",
      "import": "./dist/ownedRootPreserve.js"
    },
    "./internal/realpath-policy": {
      "types": "./dist/realpathPolicy.d.ts",
      "import": "./dist/realpathPolicy.js"
    },
    "./internal/editor-read": {
      "types": "./dist/editorRead.d.ts",
      "import": "./dist/editorRead.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./code-intelligence": {
      "types": "./dist/codeIntelligenceSurface.d.ts",
      "import": "./dist/codeIntelligenceSurface.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24.18.0 <25 || >=26.3.0 <27"
  },
  "dependencies": {
    "@oscharko-dev/keiko-contracts": "0.3.17",
    "@oscharko-dev/keiko-security": "0.3.17",
    "typescript": "~6.0.3"
  },
  "private": true
}
