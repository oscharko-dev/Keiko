{
  "name": "@oscharko-dev/keiko-workspace",
  "version": "0.2.15",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Internal workspace package: Keiko repository context and workspace access — detection, safe reads, path containment, deny/ignore rules, context packs, retrieval, and summaries. Not published independently.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internal/fs": {
      "types": "./dist/fs.d.ts",
      "import": "./dist/fs.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "dependencies": {
    "@oscharko-dev/keiko-contracts": "0.2.15",
    "@oscharko-dev/keiko-security": "0.2.15",
    "typescript": "~6.0.3"
  },
  "private": true
}
