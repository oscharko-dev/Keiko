<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <!-- KEIKO-0899: Deterministic=true is unsound without a pinned NuGet graph.
         RestorePackagesWithLockFile=true plus the committed packages.lock.json beside this
         project pin every transitive dependency. scripts/check-windows-native-quality.ps1
         passes -p:RestoreLockedMode=true on `dotnet build`, so a resolution drift fails the
         Windows native-quality gate instead of silently regenerating the lock. Do not set
         RestoreLockedMode in this project file: that would block regenerating the lock when
         bumping a PackageReference. To bump: edit the Version here, restore WITHOUT locked
         mode (EnableWindowsTargeting=true when restoring off Windows), and commit the
         updated packages.lock.json with this csproj. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- KEIKO-0934: removed <FrameworkReference Include="Microsoft.AspNetCore.App" />.
         windows-portable-rfc3161.cs is an offline RFC 3161 timestamp responder verifier and
         does not touch any ASP.NET Core surface — the framework reference bloated the
         restore graph with the ASP.NET Core targeting pack for no compiler benefit. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.9" />
    <Compile Include="../windows-portable-rfc3161.cs" Link="windows-portable-rfc3161.cs" />
  </ItemGroup>
</Project>
