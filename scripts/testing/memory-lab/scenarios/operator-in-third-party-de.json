{
  "schemaVersion": 1,
  "id": "operator-in-third-party-de",
  "language": "de",
  "class": "operator-in-third-party",
  "difficulty": "plain",
  "description": "A fact about the person inside a sentence about a colleague: the person's fact is true, the colleague's is not.",
  "truth": [
