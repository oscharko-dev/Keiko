    }
  ],
  "turns": [
    {
      "user": "Frau Ostrander rechnet alles in Excel, ich führe meine Zahlen immer im Wiki.",
      "learner": [
        {
          "body": "Ich führe meine Zahlen immer im Wiki.",
          "type": "procedural"
        }
      ]
    }
  ],
  "probes": [
    {
      "id": "own",
      "question": "Wo liegen meine Zahlen?",
      "expect": {
        "kind": "answer",
        "terms": [["Wiki"]]
      }
    },
    {
      "id": "colleague",
      "question": "Womit rechnet Frau Ostrander?",
      "expect": {
        "kind": "abstain",
        "allow": ["numbers-wiki"]
      }
    }
  ]
