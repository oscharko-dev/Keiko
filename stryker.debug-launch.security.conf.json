  "jsonReporter": {
    "fileName": "reports/mutation/debug-launch-security/mutation-report.json"
  },
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "coverageAnalysis": "perTest",
  "ignoreStatic": false,
  "timeoutMS": 30000,
  "timeoutFactor": 2.5,
  "concurrency": 16,
  "tempDirName": ".stryker-debug-launch-tmp"
