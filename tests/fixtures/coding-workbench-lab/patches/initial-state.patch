-  const gutter = options.gutter ?? DEFAULT_GUTTER;
-  const rule = options.rule ?? DEFAULT_RULE;
-  const widths = columns.map((column, index) =>
-    widthOf(
-      column,
-      rows.map((row) => row[index] ?? ""),
